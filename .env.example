# Local development database (matches docker-compose.yml)
DATABASE_URL=mysql://civicscope:civicscope@127.0.0.1:3306/civicscope

# Encrypts authenticator-app secrets at rest. Optional in development (a fixed
# development key is used); required in production. Generate with:
#   openssl rand -base64 32
# AUTH_ENCRYPTION_KEY=

# Set to "true" in production to require two-step sign-in for owners and reviewers.
# ADMIN_REQUIRE_TWO_STEP=true

# Production uses two MySQL accounts. Migrations run as the schema owner (DATABASE_URL
# above, for `pnpm db:migrate`); the web app connects as a least-privilege account that
# can only add to the history tables (audit_log, revision, candidacy_status_event)
# and cannot change the schema. Set these when running migrations to create or refresh
# that account; the migration user needs CREATE USER and GRANT OPTION. Not needed for
# local development.
# APP_DB_USER=civicscope_app
# APP_DB_PASSWORD=
# APP_DB_HOST=%
