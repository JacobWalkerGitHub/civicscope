{
  "name": "civicscope",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:generate": "pnpm --filter @civicscope/db generate",
    "db:migrate": "pnpm --filter @civicscope/db migrate",
    "db:seed": "pnpm --filter @civicscope/db seed",
    "db:verify-restore": "pnpm --filter @civicscope/db verify-restore",
    "ingest:fec": "tsx packages/cms/src/scripts/ingest-fec.ts",
    "ingest:fec-totals": "tsx packages/cms/src/scripts/ingest-fec-totals.ts",
    "ingest:legislators": "tsx packages/cms/src/scripts/ingest-legislators.ts",
    "ingest:congress": "tsx packages/cms/src/scripts/ingest-congress.ts",
    "check:congress-votes": "tsx packages/cms/src/scripts/spot-check-congress.ts",
    "check:ingest": "tsx packages/cms/src/scripts/check-ingest.ts",
    "ingest:openstates": "tsx packages/cms/src/scripts/ingest-openstates.ts",
    "dev": "pnpm --filter @civicscope/web dev",
    "admin:create-user": "pnpm --filter @civicscope/auth create-user",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:load": "tsx tests/load/run.ts",
    "data:calendar": "tsx packages/cms/src/scripts/load-calendar.ts",
    "data:legislatures": "tsx packages/cms/src/scripts/load-legislatures.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@civicscope/auth": "workspace:*",
    "@civicscope/cms": "workspace:*",
    "@civicscope/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  }
}
